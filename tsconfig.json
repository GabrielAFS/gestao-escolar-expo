{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "es2021",
    "module": "esnext",
    "jsx": "react-native",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": { "@/*": ["./src/*"] },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
